lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# ----- Virtual environments -----
.env
.env.*
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ----- Jupyter Notebook -----
.ipynb_checkpoints/

# ----- OS files -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- IDE / Editor -----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/

# ----- Testing & coverage -----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ----- Large model & data files -----
*.pt
*.pth
*.h5
*.pkl
*.npy
*.npz
*.onnx

# ----- Root-level generated images/PDFs -----
/*.pdf
/*.png
/*.jpg
/*.jpeg

# ----- Dataset image/binary directories -----
gender_dataset/resized_female_images/
gender_dataset/resized_female_masks/
gender_dataset/resized_male_images/
gender_dataset/resized_male_masks/
facet_dataset/*.gz
facet_dataset/facet_processed/*
!facet_dataset/facet_processed/splits/
facet_dataset/labeled_images/

# ----- Results — ignore noisy/large artefacts, keep key CSVs -----
results/journal_extension/coco_bbox/checkpoints/
results/journal_extension/coco_bbox/training_history/
results/journal_extension/coco_bbox/*.log
results/journal_extension/coco_bbox/*_OLD_bugged.csv
results/journal_extension/coco_bbox/*_backup.csv
results/journal_extension/coco_bbox/results copy.csv
results/journal_extension/facet_eval/archive/
results/journal_extension/facet_eval/archive2/
results/journal_extension/facet_eval/figures/
results/journal_extension/figures/

# Results within explanatory_gender_classification (duplicate run outputs)
explanatory_gender_classification/results/

# ----- Logs -----
*.log
logs/
runs/

